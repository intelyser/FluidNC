From cd176b19f73171edc2421e218bc7eea049e35407 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 07:25:26 +0400
Subject: [PATCH] WiFi: log the whole join handshake with timestamps; retry STA
 bring-up; don't give up on first missed scan

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017as23f6rrSpig18HHFh51A
---
 FluidNC/esp32/WifiImpl.cpp       | 80 ++++++++++++++++++++------------
 FluidNC/src/WebUI/WifiConfig.cpp | 29 +++++++++++-
 2 files changed, 77 insertions(+), 32 deletions(-)

diff --git a/FluidNC/esp32/WifiImpl.cpp b/FluidNC/esp32/WifiImpl.cpp
index 901655b8..41a883b8 100644
--- a/FluidNC/esp32/WifiImpl.cpp
+++ b/FluidNC/esp32/WifiImpl.cpp
@@ -307,8 +307,56 @@ namespace WebUI {
 #    endif
         }
 
+        // Register the event logging once.  Called before the first connection attempt so
+        // the whole association handshake (start, connected, got IP, disconnect reasons)
+        // is visible with millisecond timestamps, not just what happens after success.
+        void registerEvents() {
+            static bool eventsRegistered = false;
+            if (eventsRegistered) {
+                return;
+            }
+            eventsRegistered = true;
+            WiFi.onEvent(wifiEventHandler);
+            WiFi.onEvent([](arduino_event_id_t event, arduino_event_info_t info) {
+                switch (event) {
+                    case ARDUINO_EVENT_WIFI_STA_START:
+                        log_info_to(Console, "t=" << millis() << " STA: started");
+                        break;
+                    case ARDUINO_EVENT_WIFI_STA_CONNECTED:
+                        log_info_to(Console,
+                                    "t=" << millis() << " STA: associated, channel " << (int)info.wifi_sta_connected.channel << " auth "
+                                         << (int)info.wifi_sta_connected.authmode);
+                        break;
+                    case ARDUINO_EVENT_WIFI_STA_GOT_IP:
+                        log_info_to(Console, "t=" << millis() << " STA: got IP, rssi " << (int)WiFi.RSSI());
+                        break;
+                    case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
+                        log_info_to(Console, "t=" << millis() << " STA: disconnected, reason " << (int)info.wifi_sta_disconnected.reason);
+                        break;
+                    case ARDUINO_EVENT_WIFI_AP_STACONNECTED:
+                        log_info_to(Console, "AP: station joined " << mac2str(info.wifi_ap_staconnected.mac));
+                        break;
+                    case ARDUINO_EVENT_WIFI_AP_STADISCONNECTED:
+#    if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 1, 0)
+                        log_info_to(Console,
+                                    "AP: station left " << mac2str(info.wifi_ap_stadisconnected.mac) << " reason "
+                                                        << (int)info.wifi_ap_stadisconnected.reason);
+#    else
+                        log_info_to(Console, "AP: station left " << mac2str(info.wifi_ap_stadisconnected.mac));
+#    endif
+                        break;
+                    case ARDUINO_EVENT_WIFI_AP_STAIPASSIGNED:
+                        log_info_to(Console, "AP: station got an IP address");
+                        break;
+                    default:
+                        break;
+                }
+            });
+        }
+
         void prepareStartSta(int staMinSecurity, bool fastScan, const char* apCountry) override {
             (void)apCountry;
+            registerEvents();
             WiFi.enableAP(false);
             WiFi.setSleep(false);  // no modem sleep while associating
             WiFi.setMinSecurity(static_cast<wifi_auth_mode_t>(staMinSecurity));
@@ -334,6 +382,7 @@ namespace WebUI {
         }
 
         void prepareStartAp(const char* apCountry) override {
+            registerEvents();
             WiFi.enableSTA(false);
             if (apCountry && ESP_OK != esp_wifi_set_country_code(apCountry, true)) {
                 log_error("failed to set Wifi regulatory domain to " << apCountry);
@@ -343,36 +392,7 @@ namespace WebUI {
         void onStaFallbackFailure() override { esp_wifi_restore(); }
 
         void onWifiOn(int wifiPsMode) override {
-            static bool eventsRegistered = false;
-            if (!eventsRegistered) {
-                WiFi.onEvent(wifiEventHandler);
-                // Diagnostics: report who joins/leaves the AP and why, and why a STA link drops
-                WiFi.onEvent([](arduino_event_id_t event, arduino_event_info_t info) {
-                    switch (event) {
-                        case ARDUINO_EVENT_WIFI_AP_STACONNECTED:
-                            log_info_to(Console, "AP: station joined " << mac2str(info.wifi_ap_staconnected.mac));
-                            break;
-                        case ARDUINO_EVENT_WIFI_AP_STADISCONNECTED:
-#    if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 1, 0)
-                            log_info_to(Console,
-                                        "AP: station left " << mac2str(info.wifi_ap_stadisconnected.mac)
-                                                            << " reason " << (int)info.wifi_ap_stadisconnected.reason);
-#    else
-                            log_info_to(Console, "AP: station left " << mac2str(info.wifi_ap_stadisconnected.mac));
-#    endif
-                            break;
-                        case ARDUINO_EVENT_WIFI_AP_STAIPASSIGNED:
-                            log_info_to(Console, "AP: station got an IP address");
-                            break;
-                        case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
-                            log_info_to(Console, "STA: disconnected, reason " << (int)info.wifi_sta_disconnected.reason);
-                            break;
-                        default:
-                            break;
-                    }
-                });
-                eventsRegistered = true;
-            }
+            registerEvents();
             // Go through the Arduino layer so its own "sleep enabled" flag follows the
             // setting; otherwise the core re-applies modem sleep on later WiFi events.
             WiFi.setSleep(static_cast<wifi_ps_type_t>(wifiPsMode));
diff --git a/FluidNC/src/WebUI/WifiConfig.cpp b/FluidNC/src/WebUI/WifiConfig.cpp
index 4c1d5afc..a8ce1268 100644
--- a/FluidNC/src/WebUI/WifiConfig.cpp
+++ b/FluidNC/src/WebUI/WifiConfig.cpp
@@ -433,6 +433,12 @@ namespace WebUI {
                 auto ret = WiFi.status();
                 switch (ret) {
                     case WL_NO_SSID_AVAIL:
+                        // One missed scan is common right after boot; the WiFi stack keeps
+                        // retrying by itself, so only give up near the end of the wait.
+                        if (i < (max_attempts - 3)) {
+                            log_info("SSID not seen yet, retrying");
+                            break;
+                        }
                         log_info("No SSID");
                         return false;
                     case WL_CONNECT_FAILED:
@@ -574,6 +580,25 @@ namespace WebUI {
             }
         }
 
+        // A join that fails at boot often succeeds on a clean second try, so restart the
+        // whole STA bring-up a few times before giving up (or falling back to AP).
+        static bool StartSTAWithRetries() {
+            const int rounds = 4;
+            for (int round = 1; round <= rounds; ++round) {
+                if (StartSTA()) {
+                    return true;
+                }
+                if (strlen(_sta_ssid->get()) == 0 || round == rounds) {
+                    break;
+                }
+                log_info("STA join failed, restarting WiFi (attempt " << (round + 1) << " of " << rounds << ")");
+                WiFi.disconnect(true);
+                WiFi.mode(WIFI_OFF);
+                delay_ms(1000);
+            }
+            return false;
+        }
+
         static bool StartAP() {
             //Sanity check
             if ((WiFi.getMode() == WIFI_STA) || (WiFi.getMode() == WIFI_AP_STA)) {
@@ -731,12 +756,12 @@ namespace WebUI {
                     log_info("WiFi is disabled");
                     return;
                 case WiFiSTA:
-                    if (StartSTA()) {
+                    if (StartSTAWithRetries()) {
                         goto wifi_on;
                     }
                     goto wifi_off;
                 case WiFiFallback:
-                    if (StartSTA()) {
+                    if (StartSTAWithRetries()) {
                         goto wifi_on;
                     } else {  // STA failed, reset
                         WiFi.mode(WIFI_OFF);
